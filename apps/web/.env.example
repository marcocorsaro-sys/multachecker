# Site URL — used in metadata + Stripe success/cancel URLs
NEXT_PUBLIC_SITE_URL=https://multacheck.vercel.app

# Supabase — https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — needed by the Stripe webhook to bypass RLS
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Sanity CMS — https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=your-read-token
SANITY_REVALIDATE_SECRET=your-webhook-secret

# Anthropic / Claude — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Stripe — https://dashboard.stripe.com/apikeys
# Use test keys (sk_test_...) for development.
STRIPE_SECRET_KEY=sk_test_...
# Webhook signing secret from `stripe listen` or your dashboard webhook config
STRIPE_WEBHOOK_SECRET=whsec_...
